{
  "name": "tick-stream",
  "description": "Real-time quotes frontend that holds 60 fps under fast streaming updates",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @tick-stream/web dev",
    "dev:mock": "pnpm --filter @tick-stream/mock-server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1"
  }
}
