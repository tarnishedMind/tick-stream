{
  "name": "tick-stream",
  "description": "Real-time quotes frontend that holds 60 fps under fast streaming updates",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @tick-stream/web dev",
    "dev:mock": "pnpm --filter @tick-stream/mock-server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
